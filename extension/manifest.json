{
  "manifest_version": 3,
  "name": "Swiftload Catcher",
  "version": "0.4.0",
  "description": "Sends browser downloads and page videos to the Swiftload app.",
  "permissions": ["downloads", "cookies", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }]
}
